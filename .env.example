DB_CONTAINER=landman-postgis
POSTGRES_USER=landman
POSTGRES_PASSWORD=landman
POSTGRES_PORT=5432
POSTGRES_URL=postgres://landman:landman@localhost:5432/postgres?sslmode=disable
DATABASE_URL=postgres://landman:landman@localhost:5432/landman?sslmode=disable

# Optional: override the Dockerized goose runtime.
GOOSE_IMAGE=golang:1.26-alpine
GOOSE_VERSION=v3.30.0
# Maximum age of published soil evidence. Each explicit run still refreshes USDA.
SOIL_SCREENING_MAX_AGE=720h
# Required only for ./landman schedule. No schedules are enabled by default.
# UNION_PARCELS_CRON='CRON_TZ=America/New_York 0 2 * * 0,3'
# UNION_SOIL_CRON='CRON_TZ=UTC 0 3 1 */3 *'
# UNION_ZONING_CRON='CRON_TZ=UTC 0 4 * * 1'
# UNION_ROADS_CRON='CRON_TZ=UTC 0 5 * * 1'
# UNION_QUALIFICATION_CRON='CRON_TZ=UTC 0 6 * * *'

# Google sign-in. Keep these server-side. Do not use VITE_ prefixes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/auth/google/callback
AUTH_ALLOWED_EMAILS=
# Test authentication only against an explicitly disposable database.
AUTH_TEST_DATABASE_URL=

# Required for `landman` and `landman run union.tax`.
# Use four complete operator files and one persistent private artifact directory.
# UNION_TAX_ARTIFACT_DIR=
# UNION_TAX_DELINQUENT_PATH=
# UNION_TAX_BILLING_PATH=
# UNION_TAX_FORECLOSURE_PATH=
# UNION_TAX_PIPELINE_PATH=
